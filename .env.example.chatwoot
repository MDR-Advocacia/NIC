# Chatwoot Webhook Configuration
# Para configurar webhooks seguros, defina uma secret key no Chatwoot
# e configure a mesma aqui para validação HMAC-SHA256
CHATWOOT_WEBHOOK_SECRET=your_webhook_secret_here

# Exemplo de configuração no Chatwoot:
# 1. Vá para Settings > Webhooks
# 2. Adicione URL: https://your-domain.com/api/webhooks/chatwoot
# 3. Selecione eventos: message_created, conversation_created, etc.
# 4. Defina uma Webhook Secret (mesma que acima)
# 5. Salve

# Se CHATWOOT_WEBHOOK_SECRET não for definido, o webhook aceitará
# qualquer requisição (útil para desenvolvimento)